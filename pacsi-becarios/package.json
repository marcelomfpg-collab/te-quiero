{
  "name": "becarios-pacsi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "app": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  },
  "productName": "Becarios PACSI",
  "description": "Filtro de postulantes de la convocatoria Becarios PACSI 2027-A",
  "author": "Pacsi Ingenieros S.A.C.",
  "main": "electron/main.cjs",
  "build": {
    "appId": "pe.pacsiingenieros.becarios",
    "productName": "Becarios PACSI",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Becarios PACSI",
      "artifactName": "Becarios-PACSI-Instalador-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Becarios-PACSI-Portable-${version}.${ext}"
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/marcelomfpg-collab/te-quiero.git",
    "directory": "pacsi-becarios"
  }
}
